[Unit]
Description=NEIROPROFI outbound tunnel to api.telegram.org (via Hetzner)
After=network.target
Before=neiroprofi-access.service

[Service]
Type=simple
User=neiroprofi-access
Group=neiroprofi-access
# Только один проброс и только до Telegram: ключ на той стороне ограничен permitopen.
ExecStart=/usr/bin/ssh -N -q \
  -i /etc/neiroprofi-access/tunnel_key \
  -o UserKnownHostsFile=/etc/neiroprofi-access/tunnel_known_hosts \
  -o StrictHostKeyChecking=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o IdentitiesOnly=yes \
  -L 127.0.0.1:8443:api.telegram.org:443 \
  root@178.104.182.101
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
