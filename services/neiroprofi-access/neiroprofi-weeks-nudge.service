[Unit]
Description=NEIROPROFI stuck-progress nudge (via the school bot)
After=network.target

[Service]
Type=oneshot
User=neiroprofi-access
Group=neiroprofi-access
WorkingDirectory=/opt/neiroprofi-access/current
EnvironmentFile=/etc/neiroprofi-access/env
ExecStart=/usr/bin/python3 /opt/neiroprofi-access/current/weeks_bot.py nudge
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/neiroprofi-access
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=192M
